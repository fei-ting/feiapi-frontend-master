{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node", "vitest/globals"]
  },
  "include": [
    "src/main.ts",
    "src/App.vue",
    "src/env.d.ts",
    "src/components/**/*.vue",
    "src/features/interface-platform/documentation/composables/**/*.ts",
    "src/features/interface-platform/documentation/constants/**/*.ts",
    "src/features/interface-platform/documentation/types/interfaceDoc.ts",
    "src/features/interface-platform/documentation/types/interfaceDocEditor.ts",
    "src/features/interface-platform/documentation/utils/responseFieldTree.ts",
    "src/features/interface-platform/definition/composables/**/*.ts",
    "src/features/interface-platform/lifecycle/composables/**/*.ts",
    "src/features/interface-platform/publishing/composables/**/*.ts",
    "src/features/interface-platform/publishing/types/**/*.ts",
    "src/features/**/*.vue",
    "src/features/**/*.css",
    "src/router/**/*.ts",
    "src/services/http.ts",
    "src/services/interfaceInfo.ts",
    "src/services/user.ts",
    "src/services/userInterfaceInfo.ts",
    "src/stores/**/*.ts",
    "src/styles/**/*.css",
    "src/types/**/*.ts",
    "src/views/**/*.vue"
  ]
}
